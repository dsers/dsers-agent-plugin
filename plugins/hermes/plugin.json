{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "dsers",
  "version": "0.1.0",
  "description": "DSers dropshipping plugin for dropshippers using AliExpress and Shopify: product sourcing, supplier mapping, order fulfillment and shipment tracking.",
  "author": {
    "name": "DSers",
    "url": "https://www.dsers.com/"
  },
  "homepage": "https://www.dsers.com/",
  "repository": "https://github.com/dsers/dsers-agent-plugin",
  "license": "MIT",
  "keywords": [
    "dsers",
    "dropshipping",
    "dropshipper",
    "dropshippers",
    "drop-shipping",
    "aliexpress",
    "shopify",
    "ecommerce",
    "product-sourcing",
    "supplier-mapping",
    "order-fulfillment",
    "shipment-tracking",
    "hermes",
    "agent-plugin",
    "mcp"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "dsers": {
          "trust": "untrusted"
        }
      }
    }
  }
}
